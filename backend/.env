# Environment variables for India Travel Planner Backend
# Copy this to .env and fill in your API keys

SECRET_KEY=django-insecure-india-travel-planner-dev-key-2024
DEBUG=True

# Optional: Google Gemini API key for AI features
# Get yours at https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Optional: OpenWeather API key for live weather data
# Get yours at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Optional: Google Maps API key
GOOGLE_MAPS_API_KEY=

# Optional: OpenAI API key for DALL-E AI image generation
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=
